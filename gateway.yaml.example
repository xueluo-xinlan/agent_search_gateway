# agent_search_gateway 配置示例
#
# 用法：复制为 gateway.yaml 再按需修改。
#   cp gateway.yaml.example gateway.yaml
#
# 所有密钥留空 = 对应能力不启用（不会报错，只是该功能静默跳过）。
# 也可以不写进本文件，改用环境变量注入（见 README 的「密钥」一节）。
#
# 本文件由真实部署配置脱敏生成：密钥清空、绝对路径替换为占位符。

gateway:
  host: 127.0.0.1
  port: 3000
  token: ""
logging:
  level: info
  file: ''
searxng:
  url: http://127.0.0.1:8890
  timeout_ms: 20000
flaresolverr:
  url: http://127.0.0.1:8191
  enabled: true            # 2026-11-03 接通：PC(amia) 的 FlareSolverr 经 SSH 转发到 VPS:8191（pc-forward-8191.timer 自愈）
  timeout_ms: 20000        # 请求超时：PC 离线时最多等 20s（原 60s 会把 403 抓取拖死）
  max_concurrent: 2        # 并发信号量（保护浏览器资源）
  trigger_status: [403, 405, 429]   # direct 这些状态 → 升级 FlareSolverr
  fallback_on_empty: true  # direct 200 但空壳 JS → 升级
search:
  max_results: 10
  max_result_chars: 500
  cache_ttl_ms: 1800000
  cache_max_entries: 500
  max_concurrent: 2
  fallback: true
  tavily_api_key: ""
  engines: []
  fanout_default: 1
  quota_enabled: false
  # 反向图搜（ADR-0010/0012）：categories=search_by_image 时并发扇出下列图源。
  # 本机 SearXNG 无 tineye，网关会自动跳过 searxng 以免把图片 URL 当关键词搜。
  reverse_image:
    enabled: true
    category: search_by_image
    sources: [tracemoe, saucenao, baidu]
    saucenao:
      api_key: ""
      minsim: 60          # 低于 60% 多为同作品噪声，宁缺毋滥
    baidu:
      enabled: true
    publish:
      # 本机 SearXNG 没有 tineye，发布到公网图床的唯一用途（喂 tineye 拉图）不存在，
      # 开着只会：① 把用户的本地图上传到第三方图床（uguu.se）② 每次多等最多 20s。
      # 三个图源都支持 bytes 直传，关掉不影响它们。
      enabled: false
rerank:
  enabled: true
  engine_boost:
    bilibili: 1.2
    google cse: 1.0
    bing: 0.7
    duckduckgo: 1.0
    brave: 1.0
    wikipedia: 1.0
    github: 1.0
    stackoverflow: 1.0
    reddit: 1.0
    news: 1.0
  diversity:
    enabled: true
    mmr_lambda: 0.7        # MMR 多样性；1.0 = 只按分排序
    max_per_domain: 3      # 同一注册域最多 3 条
  authority:
    enabled: true
    weight: 1.0            # 组合分 = rel_norm + weight × auth
ad_filter:
  enabled: true
  level: ads+porn
  extra_domains: []
  hosts_file: ""   # 例：/path/to/hosts-file
  auto_update: true
  auto_update_interval_ms: 86400000
  allowlist:
  - wikipedia.org
  - github.com
  - github.io
  - githubusercontent.com
  - stackoverflow.com
  - stackexchange.com
  - reddit.com
  - youtube.com
  - google.com
  - bing.com
fetch:
  timeout_ms: 15000
  max_bytes: 5242880
  user_agent: ''
  block_private_ips: true
  private_ip_exempt_cidrs: []
  structural: clean
  max_output_chars: 20000
  cache_ttl_ms: 3600000
  cache_max_entries: 500
  download_dir: ""   # 例：/path/to/download-dir
browser:
  enabled: false
  headless: true
  pool_size: 1
  idle_ttl_ms: 360000
  timeout_ms: 30000
  max_concurrent: 2
  engine: chromium
  proxy_server: ''
  proxy_username: ''
  proxy_password: ""
  wait_for_selector: ''
  screenshot:
    enabled: true
    max_size: 512
    image_type: jpeg
embedding:
  enabled: true
  provider: openai
  base_url: http://127.0.0.1:8091/v1
  api_key: ""
  model: bge-small-zh-v1.5
  dim: 512
  timeout_ms: 5000
  batch_size: 16
  concurrency: 2
  max_input_chars: 2000
  query_prefix: 为这个句子生成表示以用于检索相关文章：
  passage_prefix: ''
corpus:
  enabled: true
  store_path: ""   # 例：/path/to/store-path
  ttl_ms: 2592000000
  recall_k: 10
  sweep_interval_ms: 3600000
bilibili:
  enabled: false
